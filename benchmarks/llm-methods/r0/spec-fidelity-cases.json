{
  "schema": "formal-tools/semantic-spec-cases/0.1",
  "authority": {
    "issue": 11,
    "scope": "synthetic ADS fixture only; not a domain engine",
    "review_status": "SOURCE_AUTHORED_NOT_INDEPENDENTLY_AUDITED"
  },
  "reference_requirements": [
    {
      "id": "R1",
      "text": "Dependencies form a directed acyclic graph and every predecessor finishes before its successor starts."
    },
    {
      "id": "R2",
      "text": "Two tasks writing the same resource may not execute at overlapping times; different-resource writers may overlap."
    },
    {
      "id": "R3",
      "text": "Every task must have a finite start and end time with start strictly less than end."
    }
  ],
  "cases": [
    {
      "id": "positive-sequential-same-writer",
      "description": "Same resource, adjacent nonoverlapping times",
      "tasks": {
        "A": {
          "start": 0,
          "end": 2,
          "resource": "r"
        },
        "B": {
          "start": 2,
          "end": 3,
          "resource": "r"
        }
      },
      "edges": [
        [
          "A",
          "B"
        ]
      ],
      "expected": "PASS"
    },
    {
      "id": "positive-parallel-distinct-writers",
      "description": "Different writers may overlap",
      "tasks": {
        "A": {
          "start": 0,
          "end": 2,
          "resource": "r1"
        },
        "B": {
          "start": 0,
          "end": 2,
          "resource": "r2"
        }
      },
      "edges": [],
      "expected": "PASS"
    },
    {
      "id": "negative-overlap-same-writer",
      "description": "Overlapping writes to one resource violate R2",
      "tasks": {
        "A": {
          "start": 0,
          "end": 3,
          "resource": "r"
        },
        "B": {
          "start": 1,
          "end": 4,
          "resource": "r"
        }
      },
      "edges": [],
      "expected": "FAIL"
    },
    {
      "id": "negative-cycle",
      "description": "A↔B forms a precedence cycle",
      "tasks": {
        "A": {
          "start": 0,
          "end": 1,
          "resource": "r1"
        },
        "B": {
          "start": 1,
          "end": 2,
          "resource": "r2"
        }
      },
      "edges": [
        [
          "A",
          "B"
        ],
        [
          "B",
          "A"
        ]
      ],
      "expected": "FAIL"
    },
    {
      "id": "negative-predecessor-order",
      "description": "Predecessor A ends after dependent B starts",
      "tasks": {
        "A": {
          "start": 2,
          "end": 3,
          "resource": "r1"
        },
        "B": {
          "start": 0,
          "end": 1,
          "resource": "r2"
        }
      },
      "edges": [
        [
          "A",
          "B"
        ]
      ],
      "expected": "FAIL"
    },
    {
      "id": "negative-zero-duration",
      "description": "Zero-length time interval violates R3",
      "tasks": {
        "A": {
          "start": 0,
          "end": 0,
          "resource": "r"
        }
      },
      "edges": [],
      "expected": "FAIL"
    }
  ],
  "models": [
    {
      "id": "faithful",
      "constraints": [
        "valid_windows",
        "acyclic",
        "precedence",
        "writer_exclusive"
      ],
      "expect": "ACCEPT"
    },
    {
      "id": "weak-omits-writer",
      "constraints": [
        "valid_windows",
        "acyclic",
        "precedence"
      ],
      "expect": "REJECT_WEAK"
    },
    {
      "id": "overstrong-global-exclusion",
      "constraints": [
        "valid_windows",
        "acyclic",
        "precedence",
        "writer_exclusive",
        "all_nonoverlap"
      ],
      "expect": "REJECT_OVERSTRONG"
    },
    {
      "id": "vacuous-always-false",
      "constraints": [
        "always_reject"
      ],
      "expect": "REJECT_VACUOUS"
    }
  ],
  "notes": "Reference verdicts are authored before candidate checks; synthetic property oracle is not an independent human semantic review or solver result."
}
