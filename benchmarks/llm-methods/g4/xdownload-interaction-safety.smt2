(set-logic QF_UF)
; Bounded abstraction of download-goal.mjs INTERACTION_SOURCE_VERSION dis.v0.2.download-interaction/1.
; channel_ok/request_id_ok/url_ok/size_ok model the exact input predicates in inspectDownloadGoal.
; answers_allowed models confirmDownloadGoal's closed answers allowlist (url, declaredBytes only).
; confirmReady models re-evaluation of the original bounded proposal, not any caller-supplied draft status.
(declare-const channel_ok Bool)
(declare-const request_id_ok Bool)
(declare-const url_ok Bool)
(declare-const size_ok Bool)
(declare-const answers_allowed Bool)
(declare-const confirmed Bool)
(declare-const input_valid Bool)
(declare-const inspect_awaiting_confirmation Bool)
(declare-const confirm_ready_for_kdp Bool)
(declare-const effect_dispatched Bool)
(declare-const permitted_effect Bool)
(declare-const injected_draft_ready Bool)
(assert (= input_valid (and channel_ok request_id_ok url_ok size_ok)))
(assert (= inspect_awaiting_confirmation input_valid))
(assert (= confirm_ready_for_kdp (and input_valid answers_allowed confirmed)))
(assert (= effect_dispatched false))
(assert (= permitted_effect false))
; injected_draft_ready is intentionally not an input to confirm_ready_for_kdp.
(echo "case=valid_inspect_awaiting_confirmation")
(push)
(assert channel_ok) (assert request_id_ok) (assert url_ok) (assert size_ok)
(assert inspect_awaiting_confirmation)
(check-sat)
(pop)
(echo "case=valid_confirm_ready_for_kdp")
(push)
(assert channel_ok) (assert request_id_ok) (assert url_ok) (assert size_ok)
(assert answers_allowed) (assert confirmed) (assert confirm_ready_for_kdp)
(check-sat)
(pop)
(echo "case=unconfirmed_cannot_be_ready")
(push)
(assert channel_ok) (assert request_id_ok) (assert url_ok) (assert size_ok)
(assert answers_allowed) (assert (not confirmed)) (assert confirm_ready_for_kdp)
(check-sat)
(pop)
(echo "case=unsafe_url_cannot_be_ready")
(push)
(assert channel_ok) (assert request_id_ok) (assert (not url_ok)) (assert size_ok)
(assert answers_allowed) (assert confirmed) (assert confirm_ready_for_kdp)
(check-sat)
(pop)
(echo "case=oversized_or_invalid_size_cannot_be_ready")
(push)
(assert channel_ok) (assert request_id_ok) (assert url_ok) (assert (not size_ok))
(assert answers_allowed) (assert confirmed) (assert confirm_ready_for_kdp)
(check-sat)
(pop)
(echo "case=undeclared_answer_cannot_be_ready")
(push)
(assert channel_ok) (assert request_id_ok) (assert url_ok) (assert size_ok)
(assert (not answers_allowed)) (assert confirmed) (assert confirm_ready_for_kdp)
(check-sat)
(pop)
(echo "case=forged_draft_status_does_not_bypass_revalidation")
(push)
(assert injected_draft_ready)
(assert (not input_valid))
(assert confirm_ready_for_kdp)
(check-sat)
(pop)
(echo "case=effect_dispatch_is_impossible")
(push)
(assert effect_dispatched)
(check-sat)
(pop)
(echo "case=effect_permission_is_impossible")
(push)
(assert permitted_effect)
(check-sat)
(pop)
