 "findings": {
  "F1": {
   "id": "F1",
   "title": "Model is fail-open where the kernel refuses (coercion family)",
   "cases": [
    "W-KD-G03",
    "W-KD-G04",
    "W-KD-G07",
    "W-KD-G08",
    "W-KD-G19"
   ],
   "detail": "For null / below-bound numeric string / boolean true / boolean false / single-element array declaredBytes, the T03 model evaluates JS loose coercion (e.g. null <= 1048576 is true) and selects the acquire transition (effect INTENT data only, never executed), while the original kernel raises a typed ordered-comparison violation that evaluateDomainWorkflowGuard envelopes into guard-false and the central admission then admits the unguarded refuse transition. Kernel direction: refuse. Model direction: acquire.",
   "reachability": "Not reachable through the composed T01→T03 path: validateConfirmedIntent refuses every non safe-integer (0,1TiB] declaredBytes shape, and the #166 model composes decideDownloadConfirmed behind T01 confirmation. The divergence is at the exported guard/decision-layer API surface and in the docstring claim that it evaluates \"exactly as the sealed kernel interprets\".",
   "disposition": "recorded finding; H1 model files are NOT modified in this lane — model hardening is a separate future claim"
  },
  "F2": {
   "id": "F2",
   "title": "Kernel errors at typed preparation where the model cleanly refuses",
   "cases": [
    "W-KD-G02",
    "W-KD-G09",
    "W-KD-G10"
   ],
   "detail": "For an own key carrying undefined, NaN or Infinity, the original kernel fails the event at typed preparation (PredicateContractViolation, non-JSON material), so the admission never produces a decision record; the T03 model returns a clean refuse-direction decision for the same payload.",
   "reachability": "payloadFromInput projects input.declaredBytes verbatim, so an undefined-key payload is producible from a confirm input carrying the key as undefined; NaN/Infinity inputs are producible from live JS callers (JSON round-trips would drop them).",
   "disposition": "recorded finding; same no-acquire direction, different observable (typed error vs refuse)"
  },
  "F3": {
   "id": "F3",
   "title": "The absent-field MATCH is outcome-equivalent, mechanism-different",
   "cases": [
    "W-KD-G01"
   ],
   "detail": "Kernel: readPath returns the MISSING sentinel, compareOrdered raises \"ordered comparison cannot use a missing operand\", evaluateDomainWorkflowGuard envelopes the violation into guard-false, and the unguarded refuse transition is admitted. Model: the docstring justifies refuse via JS coercion (undefined <= bound is false). Both refuse; only the kernel mechanics constitute live lte interpretation, and the trace confirms the refuse outcome itself is faithful.",
   "disposition": "recorded; supports review P2-1 closure for the missing-field case at outcome level"
  },
  "F4": {
   "id": "F4",
   "title": "The kernel profile bound alone does not encode positivity or integrality",
   "cases": [
    "W-KD-G11",
    "W-KD-G16",
    "W-KD-G17"
   ],
   "detail": "0, negative and fractional declaredBytes all PASS the kernel lte guard (numeric compare against 1 MiB only) and would admit the acquire transition at selection; positivity and safe-integer integrality are T01 grammar obligations, not guard obligations. The #166 model agrees numerically, so these are MATCHes that document the guard semantics.",
   "disposition": "recorded; no divergence"
  },
  "F5": {
   "id": "F5",
   "title": "Acquire-direction admission stops typed at the unwired dynamic-binding boundary",
   "cases": [
    "W-KD-G11",
    "W-KD-G12",
    "W-KD-G13",
    "W-KD-G16",
    "W-KD-G17"
   ],
   "detail": "After selection admits acquire, resolveAdmissionEffectIntents refuses the T03 dynamic inputFrom/idempotencyKeyFrom declarations typed (ADMISSION_EFFECT_BINDING_UNVALIDATED) because this lane never wires createOccurrenceRuntime (the trusted load boundary that also requires a Standard SDK endpoint). This is a scope boundary of the lane, not a kernel defect; the guard-level acquire agreement is the lte interpretation evidence.",
   "disposition": "recorded boundary; no Effect executes anywhere in this lane"
  }
 },
