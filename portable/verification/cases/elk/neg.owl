<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/neg">
  <owl:Ontology rdf:about=""/>
  <owl:Class rdf:about="http://example.org/neg#A"/>
  <owl:Class rdf:about="http://example.org/neg#B">
    <owl:disjointWith rdf:resource="http://example.org/neg#A"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://example.org/neg#x">
    <rdf:type rdf:resource="http://example.org/neg#A"/>
    <rdf:type rdf:resource="http://example.org/neg#B"/>
  </owl:NamedIndividual>
</rdf:RDF>
