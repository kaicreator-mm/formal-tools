{"inbound":{"result":{"tools":[{"name":"list_formal_tools","description":"List original 13 native adapters, 23 candidate portfolio tools, and 4 pure JS model checkers.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{}}},{"name":"validate_formal_source","description":"Validate Skill names and repository inputs; does NOT run proof engines.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{}}},{"name":"inspect_formal_tool","description":"Describe registered native tool usage and positive/negative fixture expectations.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"tool":{"type":"string"}},"required":["tool"]}},{"name":"probe_formal_tool","description":"Attempt a tool --version/--help via Node process, not a theorem proof.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"tool":{"type":"string"},"timeout_s":{"default":15,"type":"integer","minimum":1,"maximum":120}},"required":["tool"]}},{"name":"run_formal_fixture","description":"Execute a fixed, committed tool fixture, not arbitrary shell or user code.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"tool":{"type":"string"},"case":{"type":"string","enum":["positive","negative"]},"timeout_s":{"default":30,"type":"integer","minimum":1,"maximum":120}},"required":["tool","case"]}},{"name":"describe_native_cli","description":"Describe a tool and its named CLI operations, without executing anything.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"tool":{"type":"string"}},"required":["tool"]}},{"name":"inspect_native_installation","description":"Read-only installed executable/JAR discovery and missing dependency diagnostics. Does NOT launch native tools.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"tool":{"type":"string"}},"required":["tool"]}},{"name":"plan_native_cli","description":"Validate native CLI option values, return planned argv; NO execution and NO raw passthrough.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"tool":{"type":"string"},"operation":{"type":"string","minLength":1},"settings":{"default":{},"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":["string","number","boolean"]}}},"required":["tool","operation"]}},{"name":"list_portfolio_tools","description":"Read-only capability and tool metadata for all 36 tools. Never implies a T3/T4/T5 PASS.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{}}},{"name":"match_formal_capabilities","description":"Deterministic capability-ID to validated-tool match over the r176 container probe receipts. Read-only; capability IDs come from the frozen discovery registry. Probe receipts are technical evidence, never a T3/T4/T5/T6 or business acceptance.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"capabilities":{"minItems":1,"maxItems":16,"type":"array","items":{"type":"string","minLength":1}},"include_not_verified":{"default":false,"type":"boolean"}},"required":["capabilities"],"additionalProperties":false}},{"name":"inspect_portfolio_tool","description":"Read-only pinned portable installation metadata; no process launch.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"tool":{"type":"string"}},"required":["tool"]}},{"name":"verify_portable_fixture","description":"Run ONLY the candidate tool's committed portable pos/neg/err fixture through a SHA-pinned runner. No user input/raw argv/shell. Technical evidence only, not business verification.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"tool":{"type":"string"},"timeout_s":{"default":120,"type":"integer","minimum":1,"maximum":120}},"required":["tool"]}},{"name":"run_portfolio_operation","description":"Run a registered typed candidate operation through the shared portfolio Runner. Currently only Highs 1.15.1 solve-lp is admitted; accepts a bounded LP model, never raw argv, shell, script path or arbitrary file input.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"tool":{"type":"string","const":"highs"},"operation":{"type":"string","const":"solve-lp"},"model":{"type":"object","properties":{"sense":{"type":"string","enum":["min","max"]},"objective":{"minItems":1,"maxItems":64,"type":"array","items":{"type":"number"}},"variables":{"minItems":1,"maxItems":64,"type":"array","items":{"type":"object","properties":{"lower":{"type":["number","null"]},"upper":{"type":["number","null"]}},"required":["lower","upper"],"additionalProperties":false}},"constraints":{"maxItems":128,"type":"array","items":{"type":"object","properties":{"lower":{"type":["number","null"]},"upper":{"type":["number","null"]},"coefficients":{"maxItems":64,"type":"array","items":{"type":"number"}}},"required":["lower","upper","coefficients"],"additionalProperties":false}}},"required":["sense","objective","variables","constraints"],"additionalProperties":false},"timeout_s":{"default":30,"type":"integer","minimum":1,"maximum":30}},"required":["tool","operation","model"],"additionalProperties":false}},{"name":"verify_formal_model","description":"Run real finite-model checks in pure JS: DAG, writer exclusivity, CNF or finite state.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"engine":{"type":"string","enum":["dag","writers","cnf","states"]},"model":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["engine","model"]}},{"name":"plan_workflow","description":"Plan a bounded user problem into a formal-tools/execution-plan/1.0 workflow (PLANNING ONLY - this tool never executes anything; tool_execution stays NOT_RUN; execution exists as the separate execute_workflow tool). Deterministic z3+cvc5 cross-check template by default; the canonical problem text is used verbatim as the SMT-LIB input of both solvers. Optional provider:'deepseek' replaces the template with ONE real DeepSeek method proposal using DEEPSEEK_API_KEY from the host environment (absent key fails closed with BLOCKED_PROVIDER; never mocked).","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"problem_text":{"type":"string","minLength":1,"maxLength":65536},"assumptions":{"default":[],"maxItems":32,"type":"array","items":{"type":"string","maxLength":512}},"provider":{"type":"string","enum":["deepseek"]}},"required":["problem_text"],"additionalProperties":false}},{"name":"execute_workflow","description":"Execute a formal-tools/execution-plan/1.0 plan through the real typed DAG executor on this trusted host (the same executor the CLI 'workflow execute' path uses). Bounded typed input: the plan object (<=64KiB JSON), a REQUIRED source_sha (40-hex git commit of the caller's source tree - no anonymous or unlabeled runs), and optional tighten-only budget_caps. Plan re-validation, tool allowlist, canonical input hashes, DAG closure and budgets are enforced by the executor itself (never duplicated or bypassed here); no raw shell, no argv passthrough, no file-path inputs, no tool escalation. The host environment must provide FORMAL_PORTABLE_ROOT pointing at the pinned portable bundle; env is inherited from the MCP server process. Returns the receipt's overall verdicts (process_outcome / solver_answer / cross_tool_verdict / claim_verdict - never collapsed), per-step statuses with stream hashes (bounded log copies further truncated to 512 bytes) and receipt artifact pointers. Without the pinned bundle the executor preflight fails closed and the tool returns the honest ABORTED receipt (claim_verdict BLOCKED, fail_closed_reason BLOCKED_TOOL_MISSING) as a NON-error result - never a fabricated PASS. Invalid plans (schema/hash/budget violations) are tool errors before anything runs.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"plan":{"type":"object","properties":{"schema":{"type":"string","const":"formal-tools/execution-plan/1.0"},"plan_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"},"source":{"type":"object","properties":{"problem_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"problem_kind":{"type":"string","minLength":1,"maxLength":64}},"required":["problem_sha256","problem_kind"],"additionalProperties":false},"assumptions":{"maxItems":32,"type":"array","items":{"type":"string","maxLength":256}},"method_dag":{"maxItems":64,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","maxLength":64},"kind":{"type":"string","maxLength":64},"depends_on":{"type":"array","items":{"type":"string","maxLength":64}}},"required":["id","kind","depends_on"],"additionalProperties":false}},"budgets":{"type":"object","properties":{"max_steps":{"type":"integer","minimum":1,"maximum":1024},"max_total_timeout_s":{"type":"integer","minimum":1,"maximum":86400}},"required":["max_steps","max_total_timeout_s"],"additionalProperties":false},"compiled":{"type":"object","properties":{"launcher_sha256":{"anyOf":[{"type":"string","pattern":"^[a-f0-9]{64}$"},{"type":"null"}]},"manifest_sha256":{"anyOf":[{"type":"string","pattern":"^[a-f0-9]{64}$"},{"type":"null"}]}},"required":["launcher_sha256","manifest_sha256"],"additionalProperties":false},"steps":{"minItems":1,"maxItems":1024,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},"tool":{"type":"string","enum":["z3","cvc5","highs","compare"]},"operation":{"type":"string","enum":["solve-smt","solve-lp","cross-check"]},"depends_on":{"maxItems":64,"type":"array","items":{"type":"string","minLength":1,"maxLength":64}},"input":{},"input_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"timeout_s":{"type":"integer","minimum":1,"maximum":120},"expected_output_kind":{"type":"string","enum":["smt-answer","lp-status","cross-tool-verdict"]}},"required":["id","tool","operation","depends_on","input","input_sha256","timeout_s","expected_output_kind"],"additionalProperties":false}}},"required":["schema","plan_id","source","assumptions","method_dag","budgets","compiled","steps"],"additionalProperties":false},"source_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"budget_caps":{"type":"object","properties":{"max_steps":{"type":"integer","minimum":1,"maximum":1024},"max_total_timeout_s":{"type":"integer","minimum":1,"maximum":86400}},"additionalProperties":false}},"required":["plan","source_sha"],"additionalProperties":false}}]},"jsonrpc":"2.0","id":2}}
