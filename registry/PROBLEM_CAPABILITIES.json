      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "planning.classical",
      "label": "自动规划",
      "limitations": "Action preconditions and effects are model-dependent",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "causal.inference",
      "label": "因果推断",
      "limitations": "Confounding and identifiability matter",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "causal.discovery",
