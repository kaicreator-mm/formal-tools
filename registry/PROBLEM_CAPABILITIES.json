      "label": "演绎证明",
      "limitations": "Assumptions and proposition require semantic review",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "model.state",
      "label": "状态模型检查",
      "limitations": "Bounds/abstractions matter",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "model.relational",
      "label": "关系模型",
      "limitations": "Finite scopes may not prove universal properties",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "logic.rules",
      "label": "规则推理",
      "limitations": "Rule/closed-world assumptions matter",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "knowledge.rdf",
      "label": "RDF/SHACL",
      "limitations": "Shape compliance is not factual accuracy",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "opt.combinatorial",
      "label": "组合优化",
      "limitations": "Objective and feasibility are model-relative",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "opt.numerical",
      "label": "数值优化",
      "limitations": "Numerical tolerance/gap is significant",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "math.symbolic",
      "label": "符号数学",
      "limitations": "Domains and assumptions must be explicit",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "graph.algorithms",
      "label": "图论/DAG",
      "limitations": "Graph completeness must be verified",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "test.property",
      "label": "属性测试",
      "limitations": "No failure found does not prove correctness",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "test.fuzz",
      "label": "模糊测试",
      "limitations": "Coverage remains partial",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "code.verify",
      "label": "程序验证",
      "limitations": "Program semantics and boundedness matter",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "model.probabilistic",
      "label": "概率模型检查",
      "limitations": "Requires calibrated transition probabilities",
      "claim_scope": "FORMAL_CHECKABLE_WITH_EXPLICIT_MODEL"
    },
    {
      "id": "stats.bayesian",
      "label": "贝叶斯推断",
